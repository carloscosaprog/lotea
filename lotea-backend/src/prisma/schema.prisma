generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario       Int      @id @default(autoincrement())
  nombre           String   @db.VarChar(100)
  email            String   @unique @db.VarChar(150)
  contrasena       String   @db.VarChar(255)
  avatar           String?
  latitud          Float?
  longitud         Float?
  ciudad           String?
  direccion        String?
  fecha_registro   DateTime @default(now())

  lotes            Lote[]              @relation("VendedorLotes")
  favoritos        Favorito[]
  pedidos          Pedido[]
  grupos_creados   Grupo_Compra[]      @relation("CreadorGrupos")
  participaciones  Participacion_Grupo[]
  solicitudes      Solicitud_Lote[]
  mensajes_enviados   Mensaje[]        @relation("Emisor")
  mensajes_recibidos  Mensaje[]        @relation("Receptor")
  notificaciones    Notificacion[]
  calificaciones_comprador Calificacion[] @relation("CompradorCalificaciones")
  calificaciones_vendedor  Calificacion[] @relation("VendedorCalificaciones")

  @@map("usuario")
}

model Categoria {
  id_categoria Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(100)
  slug         String  @unique @db.VarChar(120)

  icono        String? @db.VarChar(100)
  imagen       String? @db.VarChar(255)

  id_padre     Int?

  padre        Categoria? @relation("CategoriaJerarquia", fields: [id_padre], references: [id_categoria])
  subcategorias Categoria[] @relation("CategoriaJerarquia")

  lotesCategorias Lote_Categoria[]

  @@unique([nombre, id_padre])

  @@index([id_padre])

  @@map("categoria")
}



model Lote {
  id_lote           Int      @id @default(autoincrement())
  titulo            String   @db.VarChar(150)
  descripcion       String?
  precio            Decimal  @db.Decimal(10, 2)
  cantidad          Int
  id_vendedor       Int
  fecha_publicacion DateTime @default(now())

  vendedor          Usuario           @relation("VendedorLotes", fields: [id_vendedor], references: [id_usuario], onDelete: Cascade)

  categorias        Lote_Categoria[]

  imagenes          Imagen_Lote[]
  favoritos         Favorito[]
  detalles_pedido   Detalle_Pedido[]
  grupos_compra     Grupo_Compra[]
  mensajes          Mensaje[]

  @@map("lote")
}

model Lote_Categoria {
  id_lote      Int
  id_categoria Int

  lote      Lote      @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)
  categoria Categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)

  @@id([id_lote, id_categoria])
  @@map("lote_categoria")
}

model Imagen_Lote {
  id_imagen    Int     @id @default(autoincrement())
  id_lote      Int
  url          String
  es_principal Boolean @default(false)

  lote         Lote    @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)

  @@map("imagen_lote")
}

model Favorito {
  id_favorito Int      @id @default(autoincrement())
  id_usuario  Int
  id_lote     Int
  fecha       DateTime @default(now())

  usuario     Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  lote        Lote     @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)

  @@unique([id_usuario, id_lote])
  @@index([id_usuario])
  @@map("favorito")
}

model Pedido {
  id_pedido           Int      @id @default(autoincrement())
  id_usuario          Int
  fecha               DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  estado              EstadoPedido @default(pendiente_pago)
  metodo_pago         MetodoPago?
  direccion_entrega   String?

  usuario    Usuario          @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  detalles   Detalle_Pedido[]
  calificacion Calificacion?

  @@map("pedido")
}

model Calificacion {
  id_calificacion Int      @id @default(autoincrement())
  id_pedido       Int      @unique
  id_comprador    Int
  id_vendedor     Int
  puntuacion      Int
  comentario      String?
  fecha_creacion  DateTime @default(now())

  pedido     Pedido  @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  comprador  Usuario @relation("CompradorCalificaciones", fields: [id_comprador], references: [id_usuario], onDelete: Restrict)
  vendedor   Usuario @relation("VendedorCalificaciones", fields: [id_vendedor], references: [id_usuario], onDelete: Restrict)

  @@index([id_vendedor, fecha_creacion])
  @@index([id_comprador])
  @@map("calificacion")
}

model Detalle_Pedido {
  id_detalle      Int     @id @default(autoincrement())
  id_pedido       Int
  id_lote         Int
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)

  pedido          Pedido  @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  lote            Lote    @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)

  @@map("detalle_pedido")
}

model Notificacion {
  id_notificacion Int      @id @default(autoincrement())
  id_usuario      Int
  contenido       String
  tipo            String   @default("pedido")
  leida           Boolean  @default(false)
  fecha           DateTime @default(now())

  usuario         Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([id_usuario, leida])
  @@map("notificacion")
}

model Grupo_Compra {
  id_grupo         Int      @id @default(autoincrement())
  id_lote          Int
  id_creador       Int
  cantidad_objetivo Int
  estado           EstadoGrupo @default(abierto)

  lote             Lote     @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)
  creador          Usuario  @relation("CreadorGrupos", fields: [id_creador], references: [id_usuario], onDelete: Cascade)
  participaciones  Participacion_Grupo[]

  @@map("grupo_compra")
}

model Participacion_Grupo {
  id_participacion  Int  @id @default(autoincrement())
  id_grupo          Int
  id_usuario        Int
  cantidad_aportada Int

  grupo             Grupo_Compra @relation(fields: [id_grupo], references: [id_grupo], onDelete: Cascade)
  usuario           Usuario      @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("participacion_grupo")
}

model Solicitud_Lote {
  id_solicitud Int      @id @default(autoincrement())
  id_usuario   Int
  descripcion  String
  fecha        DateTime @default(now())

  usuario      Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("solicitud_lote")
}

model Mensaje {
  id_mensaje Int      @id @default(autoincrement())
  id_emisor  Int
  id_receptor Int
  id_lote    Int?
  contenido  String
  fecha      DateTime @default(now())
  leido      Boolean  @default(false)

  emisor     Usuario  @relation("Emisor",   fields: [id_emisor],   references: [id_usuario], onDelete: Cascade)
  receptor   Usuario  @relation("Receptor", fields: [id_receptor], references: [id_usuario], onDelete: Cascade)
  lote       Lote?    @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade)

  @@index([id_lote])
  @@index([id_receptor, leido])
  @@map("mensaje")
}

enum EstadoPedido {
  pendiente_pago
  pagado
  preparando
  enviado
  entregado
  cancelado
}

enum MetodoPago {
  tarjeta
  paypal
  bizum
  transferencia
}

enum EstadoGrupo {
  abierto
  cerrado
}
